# Lecture pipeline — download a McGill recording and turn it into per-slide study
# pages + context docs. The real CLI is ./lp (./lp --help); these are shortcuts.
# Full guide: docs/GUIDE.md
#
# Typical use, per lecture:
#   1. Chrome extension on the Lecture Recordings page -> Copy
#   2. paste:  ./lp run '<signed url>' --date 2026-10-01 --course-id 97394

# list available commands
default:
    @just --list --unsorted

# one-time: create the venv and install dependencies
setup:
    test -d .venv || uv venv --python 3.12
    uv pip install -r requirements.txt
    @./lp check

# check prerequisites (tools, keys, course profiles)
check:
    @./lp check

# older copy-paste form: just lecture '<url>' <slug> "<title>" <date>  (default course)
lecture url slug title date:
    ./lp run '{{url}}' --slug '{{slug}}' --title '{{title}}' --date '{{date}}'

# rebuild a lecture from a stage onwards: fetch | transcribe | slides | notes | study
redo slug from="slides":
    ./lp redo '{{slug}}' --from '{{from}}'

# every lecture and what it has
list:
    @./lp list

# course profiles
courses:
    @./lp courses

# open the study page (lean)
open slug:
    ./lp open '{{slug}}'

# open the study page with the lecture audio inside
open-audio slug:
    ./lp open '{{slug}}' --audio

# open the Word document (AI context)
open-doc slug:
    ./lp open '{{slug}}' --doc

# print the DevTools snippet that copies signed URLs (fallback to the extension)
urls course="":
    @./lp urls {{ if course != "" { "--course " + course } else { "" } }}

# open chrome://extensions for loading the unpacked extension
ext-dev:
	open -a "Google Chrome" "chrome://extensions"
